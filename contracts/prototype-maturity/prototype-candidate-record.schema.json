{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Prototype Candidate Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "record_id",
    "prototype_id",
    "promoted_at",
    "promoted_by",
    "request_ref",
    "packet_ref",
    "readiness_ref",
    "decision_ref",
    "expected_state",
    "accepted_values",
    "record_digest"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "artifact_type": { "const": "prototype-candidate-record" },
    "record_id": {
      "type": "string",
      "pattern": "^prototype-candidate:[a-z0-9][a-z0-9._-]*:[0-9]+$"
    },
    "prototype_id": {
      "type": "string",
      "pattern": "^prototype:[a-z0-9][a-z0-9._-]*$"
    },
    "promoted_at": { "type": "string", "format": "date-time" },
    "promoted_by": { "$ref": "#/$defs/text" },
    "request_ref": { "$ref": "#/$defs/ref" },
    "packet_ref": { "$ref": "#/$defs/ref" },
    "readiness_ref": { "$ref": "#/$defs/ref" },
    "decision_ref": { "$ref": "#/$defs/ref" },
    "expected_state": { "$ref": "#/$defs/sourceState" },
    "accepted_values": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prototype-objective",
        "target-user",
        "expected-proof",
        "accepted-scope",
        "excluded-scope",
        "boundary-clarifications",
        "open-issue-disposition"
      ],
      "properties": {
        "prototype-objective": { "$ref": "#/$defs/text" },
        "target-user": { "$ref": "#/$defs/text" },
        "expected-proof": { "$ref": "#/$defs/text" },
        "accepted-scope": { "$ref": "#/$defs/textList" },
        "excluded-scope": { "$ref": "#/$defs/textList" },
        "boundary-clarifications": { "$ref": "#/$defs/text" },
        "open-issue-disposition": { "$ref": "#/$defs/text" }
      }
    },
    "record_digest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "text": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "digest"],
      "properties": {
        "id": { "$ref": "#/$defs/text" },
        "digest": { "$ref": "#/$defs/digest" }
      }
    },
    "sourceState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_revision", "record_digest", "lifecycle"],
      "properties": {
        "source_revision": { "$ref": "#/$defs/text" },
        "record_digest": { "$ref": "#/$defs/digest" },
        "lifecycle": { "const": "exploring" }
      }
    },
    "textList": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/text" }
    }
  }
}
