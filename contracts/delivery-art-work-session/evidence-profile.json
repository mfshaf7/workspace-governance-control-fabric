{
  "schema_version": 1,
  "profile_id": "wgcf-delivery-art-evidence-v1",
  "owner_repo": "workspace-governance-control-fabric",
  "commands": [
    {
      "id": "owner-repository-tests",
      "kind": "tests",
      "name": "WGCF owner repository validation and test suite",
      "executable": "python3",
      "args": ["scripts/run_delivery_art_evidence.py", "--repo-root", "."],
      "fidelity": "filesystem",
      "conformance_binding": "matching-fidelity",
      "timeout_seconds": 1200
    },
    {
      "id": "source-diff-validation",
      "kind": "validations",
      "name": "Source diff whitespace validation",
      "executable": "git",
      "args": ["diff", "--check", "{{base_commit}}...{{head_commit}}"],
      "fidelity": "real-git",
      "conformance_binding": "matching-fidelity",
      "timeout_seconds": 60
    }
  ]
}
