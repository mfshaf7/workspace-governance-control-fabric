{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://operator-orchestration-service.local/contracts/catalog/repository-readiness-reference.schema.json",
  "title": "WGCF repository readiness reference",
  "type": "object",
  "additionalProperties": false,
  "required": ["repo_name", "repo_ref", "catalog_value_key", "receipt"],
  "properties": {
    "repo_name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "repo_ref": { "type": "string", "pattern": "^repo://[a-z0-9][a-z0-9-]*$" },
    "catalog_value_key": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["receipt_id", "uri", "digest", "issuer", "target_scope", "outcome", "evaluated_at", "generation"],
      "properties": {
        "receipt_id": { "type": "string", "minLength": 1 },
        "uri": { "type": "string", "pattern": "^wgcf://receipts/" },
        "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "issuer": { "const": "workspace-governance-control-fabric" },
        "target_scope": { "type": "string", "pattern": "^repo:[a-z0-9][a-z0-9-]*$" },
        "outcome": { "const": "ready" },
        "evaluated_at": { "type": "string", "format": "date-time" },
        "generation": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
