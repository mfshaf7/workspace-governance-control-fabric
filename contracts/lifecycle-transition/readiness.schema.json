{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mfshaf7.dev/schemas/lifecycle-transition-readiness.schema.json",
  "title": "Lifecycle Transition Readiness",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "readiness_id",
    "evaluated_at",
    "valid_until",
    "transition",
    "source",
    "outcome",
    "findings",
    "escalation",
    "next_action",
    "evidence_refs",
    "authority",
    "implementation_ref",
    "readiness_digest"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "artifact_type": { "const": "lifecycle-transition-readiness" },
    "readiness_id": { "$ref": "#/$defs/nonEmptyString" },
    "evaluated_at": { "type": "string", "format": "date-time" },
    "valid_until": { "type": "string", "format": "date-time" },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["transition_id", "route_id", "state", "correlation_id"],
      "properties": {
        "transition_id": { "$ref": "#/$defs/nonEmptyString" },
        "route_id": {
          "enum": ["proposal-to-delivery", "proposal-to-prototype", "prototype-to-delivery"]
        },
        "state": { "$ref": "#/$defs/nonEmptyString" },
        "correlation_id": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record_ref", "source_revision", "event_sequence", "projection_digest"],
      "properties": {
        "record_ref": { "$ref": "#/$defs/nonEmptyString" },
        "source_revision": { "$ref": "#/$defs/nonEmptyString" },
        "event_sequence": { "type": "integer", "minimum": 0 },
        "projection_digest": { "$ref": "#/$defs/sha256" }
      }
    },
    "outcome": { "enum": ["ready", "blocked", "requires-action", "terminal"] },
    "findings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "severity", "message", "owner_ref"],
        "properties": {
          "code": { "$ref": "#/$defs/nonEmptyString" },
          "severity": { "enum": ["info", "warning", "blocking"] },
          "message": { "$ref": "#/$defs/nonEmptyString" },
          "owner_ref": { "$ref": "#/$defs/nonEmptyString" }
        }
      }
    },
    "escalation": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["reason_code", "owner_ref", "required_fix", "review_at", "evidence_refs"],
          "properties": {
            "reason_code": { "$ref": "#/$defs/nonEmptyString" },
            "owner_ref": { "$ref": "#/$defs/nonEmptyString" },
            "required_fix": { "$ref": "#/$defs/nonEmptyString" },
            "review_at": {
              "oneOf": [
                { "type": "string", "format": "date-time" },
                { "type": "null" }
              ]
            },
            "evidence_refs": { "$ref": "#/$defs/referenceList" }
          }
        }
      ]
    },
    "next_action": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["action", "owner_ref", "review_at"],
          "properties": {
            "action": { "$ref": "#/$defs/nonEmptyString" },
            "owner_ref": { "$ref": "#/$defs/nonEmptyString" },
            "review_at": {
              "oneOf": [
                { "type": "string", "format": "date-time" },
                { "type": "null" }
              ]
            }
          }
        }
      ]
    },
    "evidence_refs": { "$ref": "#/$defs/referenceList" },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner_ref", "contract_ref", "contract_digest"],
      "properties": {
        "owner_ref": { "const": "workspace-governance-control-fabric" },
        "contract_ref": { "$ref": "#/$defs/nonEmptyString" },
        "contract_digest": { "$ref": "#/$defs/sha256" }
      }
    },
    "implementation_ref": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "readiness_digest": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "referenceList": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 128,
      "items": { "$ref": "#/$defs/nonEmptyString" }
    }
  }
}
