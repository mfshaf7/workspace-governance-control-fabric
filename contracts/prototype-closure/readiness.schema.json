{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_type", "readiness_id", "readiness_digest", "evaluated_at", "request_ref", "prototype_id", "action", "actor", "operator_id", "source_revision", "record_digest", "contract_digest", "security_review_ref", "outcome", "checks", "findings", "evidence", "evidence_digest"],
  "properties": {
    "schema_version": {"const": 1},
    "artifact_type": {"const": "prototype-closure-readiness"},
    "readiness_id": {"type": "string", "minLength": 1, "maxLength": 192},
    "readiness_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "evaluated_at": {"type": "string", "format": "date-time"},
    "request_ref": {"type": "object", "additionalProperties": false, "required": ["id", "digest"], "properties": {"id": {"type": "string"}, "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}},
    "prototype_id": {"type": "string"},
    "action": {"enum": ["apply-delivery", "graduate-source", "retire-incubation", "reopen-incubation"]},
    "actor": {"type": "string"},
    "operator_id": {"type": "string"},
    "source_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "record_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "contract_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "security_review_ref": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "outcome": {"enum": ["ready", "blocked", "stale"]},
    "checks": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["id", "state"], "properties": {"id": {"type": "string"}, "state": {"enum": ["ready", "blocked", "stale"]}}}},
    "findings": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["code", "detail", "owner_ref"], "properties": {"code": {"type": "string"}, "detail": {"type": "string"}, "owner_ref": {"type": "string"}}}},
    "evidence": {"type": "array", "maxItems": 16, "items": {"type": "object", "additionalProperties": false, "required": ["field", "ref", "owner_ref", "digest", "state", "subject_ref", "source_revision"], "properties": {"field": {"type": "string", "maxLength": 64}, "ref": {"type": "string", "maxLength": 512}, "owner_ref": {"type": "string", "maxLength": 256}, "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "state": {"enum": ["accepted", "missing", "revoked", "stale", "denied"]}, "subject_ref": {"type": ["string", "null"], "maxLength": 512}, "source_revision": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"}}}},
    "evidence_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
