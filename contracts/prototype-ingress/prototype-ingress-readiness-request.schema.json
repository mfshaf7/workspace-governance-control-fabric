{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workspace-governance.local/wgcf/prototype-ingress-readiness-request.schema.json",
  "title": "Prototype Ingress Readiness Request V1",
  "description": "One exact Prototype Delivery packet submitted for a non-mutating WGCF eligibility decision.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile_id", "packet"],
  "properties": {
    "schema_version": { "const": 1 },
    "profile_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]{0,63}$"
    },
    "packet": { "type": "object" }
  }
}
